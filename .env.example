OPENAI_API_KEY=your-openai-api-key
SERPER_API_KEY=your-serper-api-key
FIRECRAWL_API_KEY=your-firecrawl-api-key

# Phase 1 (MVP) — OpenAI primary (cheapest tier)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-5-nano

# CrewAI / LiteLLM（エージェント LLM。未設定時は OPENAI_CHAT_MODEL を使用）
# OPENAI_MODEL_NAME=gpt-5-nano

# Local job corpus (SQLite). Default: data/jobs.db
# JOB_DB_PATH=data/jobs.db

# Phase 2 — Vertex AI (optional; uncomment when integrating)
# AI_PROVIDER=vertex
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=asia-northeast1
# VERTEX_EMBEDDING_MODEL=text-embedding-005
# VERTEX_GEMINI_MODEL=gemini-2.0-flash-001
